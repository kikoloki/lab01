# Base URL must include your provider's API prefix (often /v1).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Enter an exact model ID available from YOUR provider, with function calling support.
OPENAI_MODEL=
# Some compatible providers do not support strict:true. Local validation is always enabled.
OPENAI_STRICT_TOOLS=false
# For Alibaba Qwen: set false (Qwen does not reliably support tool_choice=required).
OPENAI_REQUIRE_TOOL_CHOICE=true
# Alibaba Qwen non-streaming demo: set false. Leave blank for other providers.
OPENAI_ENABLE_THINKING=
